# Bật mock backend cho môi trường dev/demo.
VITE_USE_MOCK=false

# Base URL của Spring Boot API. Khi deploy cùng domain qua Nginx, giữ /api/v1.
# Khi gọi trực tiếp: http://localhost:8080/api/v1
VITE_API_URL=/api/v1

# Vite dev proxy (chỉ dùng khi chạy `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:8080
